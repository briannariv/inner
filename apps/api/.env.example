# "ephemeris" (default, real Swiss Ephemeris + real HD engine, no keys needed),
# "mock" (deterministic placeholder data), or "hosted" (third-party vendor APIs)
CHART_PROVIDER=ephemeris

# Only required when CHART_PROVIDER=hosted — see apps/api/src/providers/hosted/
# for integration notes and the response-mapping confidence caveats.
ASTROLOGY_API_USER_ID=
ASTROLOGY_API_KEY=
HD_API_KEY=

PORT=4000
